            </intent-filter>
        </activity-alias>

        <!-- Cyber Icon (Disabled by default) -->
        <activity-alias
            android:name=".CyberIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/logo_square_medium_custom3"
            android:roundIcon="@mipmap/logo_square_medium_custom3"
