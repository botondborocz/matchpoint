<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:usesCleartextTraffic="true" android:allowBackup="true"
        android:icon="@mipmap/logo_square_medium"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/match_logo_generated"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="chat_messages" />
        <service
            android:name=".notifications.MyFirebaseMessagingService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name="org.ttproject.util.AiCoachService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_name" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.Starting">
        </activity>
        <!-- Default Icon (Enabled) -->
        <activity-alias
            android:name=".DefaultIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/logo_square_medium"
            android:roundIcon="@mipmap/logo_square_medium"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Light Icon (Disabled by default) -->
        <activity-alias
            android:name=".LightIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/logo_square_medium_light"
            android:roundIcon="@mipmap/logo_square_medium_light"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Gold Icon (Disabled by default) -->
        <activity-alias
            android:name=".GoldIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/logo_square_medium_custom1"
            android:roundIcon="@mipmap/logo_square_medium_custom1"
            android:targetActivity=".MainActivity">
            <intent-filter>
